{
  "name": "extension-use-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "pnpm -r --filter ./packages/* build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && vitest run",
    "test:e2e": "pnpm build && pnpm example:build && playwright test",
    "example:build": "node examples/basic-extension/build.mjs && node examples/controller-app/build.mjs",
    "example:serve": "node examples/controller-app/serve.mjs",
    "docs:actions": "node scripts/gen-actions-doc.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:deploy": "pnpm docs:build && wrangler deploy",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@extension-use/client": "workspace:*",
    "@extension-use/mcp": "workspace:*",
    "@extension-use/relay": "workspace:*",
    "@extension-use/testing": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.56.1",
    "@types/chrome": "^0.1.27",
    "@types/node": "^24.10.0",
    "esbuild": "^0.25.12",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitepress": "1.6.4",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
