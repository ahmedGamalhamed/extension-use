// The docs site (docs/): a Cloudflare Worker that only serves the static VitePress build.
// Deployed by Cloudflare Workers Builds (dashboard Git integration) on pushes to main:
//   build command:  pnpm docs:build
//   deploy command: npx wrangler deploy
// By hand: pnpm docs:deploy
{
  "name": "extension-use-docs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./docs/.vitepress/dist",
    // cleanUrls: /start/picker serves start/picker.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "extension-use.appzlr.com", "custom_domain": true }],
  "workers_dev": false
}
