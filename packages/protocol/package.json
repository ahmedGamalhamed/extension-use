{
  "name": "@extension-use/protocol",
  "version": "0.1.0",
  "description": "Message protocol and action schemas for Extension-use",
  "license": "MIT",
  "author": "Ahmed Gamal",
  "homepage": "https://extension-use.appzlr.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmedGamalhamed/extension-use.git",
    "directory": "packages/protocol"
  },
  "bugs": {
    "url": "https://github.com/ahmedGamalhamed/extension-use/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "source": "./src/schemas.ts",
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    },
    "./remote": {
      "source": "./src/remote.ts",
      "types": "./dist/remote.d.ts",
      "default": "./dist/remote.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/schemas.ts src/remote.ts --format esm --dts --clean"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "manifest-v3",
    "side-panel",
    "automation",
    "extension-use"
  ]
}
