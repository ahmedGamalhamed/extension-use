{
  "name": "@extension-use/mcp",
  "version": "0.2.0",
  "description": "MCP server that lets AI agents use your real browser, locally or through an Extension-use relay",
  "license": "MIT",
  "author": "Ahmed Gamal",
  "homepage": "https://extension-use.appzlr.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmedGamalhamed/extension-use.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/ahmedGamalhamed/extension-use/issues"
  },
  "type": "module",
  "bin": {
    "extension-use-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@extension-use/client": "workspace:*",
    "@extension-use/protocol": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@extension-use/host": "workspace:*",
    "@extension-use/relay": "workspace:*",
    "@types/ws": "^8.18.1"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "browser-automation",
    "browser-extension",
    "extension-use"
  ]
}
